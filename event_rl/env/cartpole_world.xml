<mujoco model="cartpole_world">
  <compiler inertiafromgeom="true" angle="degree"/>
  <option timestep="0.02" gravity="0 0 -9.81"/>
  <default>
    <joint damping="1" armature="0"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.8 0.1 0.1"/>
  </default>
  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.65 0.80 0.95" rgb2="0.10 0.20 0.35" width="512" height="512"/>
    <texture name="ground_tex" type="2d" builtin="checker" rgb1="0.85 0.85 0.82" rgb2="0.25 0.45 0.30" width="512" height="512" mark="edge" markrgb="0.9 0.9 0.9"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="16 8" texuniform="true" reflectance="0.1"/>
  </asset>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <map znear="0.01" zfar="80"/>
  </visual>
  <worldbody>
    <light name="top_light" pos="0 -3 6" dir="0 1 -1" diffuse="0.8 0.8 0.8" castshadow="true"/>
    <camera name="side" pos="0 -8.5 2.0" xyaxes="1 0 0 0 0 1" fovy="50"/>
    <geom name="floor" type="plane" pos="0 0 -0.035" size="10 10 0.05" material="ground_mat"/>
    <geom name="track" type="box" pos="0 0 0.015" size="2.6 0.035 0.015" rgba="0.20 0.20 0.22 1"/>
    <geom name="left_stop" type="box" pos="-2.45 0 0.10" size="0.035 0.09 0.10" rgba="0.45 0.45 0.45 1"/>
    <geom name="right_stop" type="box" pos="2.45 0 0.10" size="0.035 0.09 0.10" rgba="0.45 0.45 0.45 1"/>
    <!-- Static, non-colliding background geometry forming a mountain skyline.
         Each "mountain" is a box rotated 45 deg about Y and half-buried at the
         ground plane, so only the diamond's top half pokes up as a triangular
         peak (MuJoCo has no cone/pyramid primitive). Farther peaks are sized
         larger but tinted lighter/hazier for atmospheric-perspective depth. -->
    <geom name="mtn1" type="box" pos="-8 11 -0.035" euler="0 45 0" size="1.6 2.0 1.6" rgba="0.30 0.34 0.44 1" contype="0" conaffinity="0"/>
    <geom name="mtn2" type="box" pos="-4 13 -0.035" euler="0 45 0" size="2.2 2.0 2.2" rgba="0.44 0.50 0.60 1" contype="0" conaffinity="0"/>
    <geom name="mtn3" type="box" pos="0 12 -0.035" euler="0 45 0" size="1.9 2.0 1.9" rgba="0.36 0.40 0.50 1" contype="0" conaffinity="0"/>
    <geom name="mtn4" type="box" pos="4.5 13.5 -0.035" euler="0 45 0" size="2.4 2.0 2.4" rgba="0.47 0.53 0.63 1" contype="0" conaffinity="0"/>
    <geom name="mtn5" type="box" pos="8 11 -0.035" euler="0 45 0" size="1.7 2.0 1.7" rgba="0.32 0.36 0.46 1" contype="0" conaffinity="0"/>
    <geom name="sun" type="sphere" pos="-9 15 7" size="0.7" rgba="0.98 0.86 0.4 1" contype="0" conaffinity="0"/>
    <body name="cart" pos="0 0 0.13">
      <joint name="slider" type="slide" axis="1 0 0" limited="true" range="-2.4 2.4"/>
      <geom name="cart_body" type="box" size="0.24 0.12 0.07" rgba="0.10 0.33 0.75 1" mass="1.0"/>
      <geom name="cart_top" type="box" pos="0 0 0.08" size="0.14 0.09 0.025" rgba="0.08 0.22 0.55 1" mass="0.05"/>
      <geom name="left_wheel" type="sphere" pos="-0.15 -0.13 -0.06" size="0.035" rgba="0.05 0.05 0.05 1" mass="0.02"/>
      <geom name="right_wheel" type="sphere" pos="0.15 -0.13 -0.06" size="0.035" rgba="0.05 0.05 0.05 1" mass="0.02"/>
      <body name="pole" pos="0 0 0.13">
        <joint name="hinge" type="hinge" axis="0 1 0" limited="false"/>
        <geom name="pole_bar" type="box" pos="0 0 0.42" size="0.025 0.025 0.42" rgba="0.95 0.48 0.10 1" mass="0.1"/>
        <geom name="pole_tip" type="box" pos="0 0 0.86" size="0.06 0.025 0.025" rgba="0.95 0.48 0.10 1" mass="0.01"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="slide_motor" joint="slider" gear="100" ctrllimited="true" ctrlrange="-3 3"/>
  </actuator>
</mujoco>
