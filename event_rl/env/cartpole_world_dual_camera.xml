<mujoco model="cartpole_world">
  <compiler inertiafromgeom="true" angle="degree"/>

  <option timestep="0.02" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1" armature="0"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.8 0.1 0.1"/>
  </default>

  <asset>
    <!-- Terrain ported from inspo codebase (URV-Summer-2026/cartpole_video/event);
         see generate_terrain.py. -->
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.65 0.80 0.95" rgb2="0.10 0.20 0.35" width="512" height="512"/>

    <texture name="path_tex" type="2d" file="assets/textures/PavingStones116.png" width="1024" height="1024"/>
    <material name="path_mat" texture="path_tex" specular="1.0" shininess="0.0" texrepeat="7 7" rgba="1 1 1 1"/>

    <texture name="lower_floor_tex" type="2d" file="assets/textures/PavingStones045.png" width="1024" height="1024"/>
    <material name="lower_floor_mat" texture="lower_floor_tex" specular="1.0" shininess="0.0" texrepeat="10 10" rgba="1 1 1 1"/>

    <hfield name="terrain" size="4.2 2.0 0.6 0.3" content_type="image/png" file="assets/terrain_heightmap.png" nrow="300" ncol="1200"/>
  </asset>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <map znear="0.01" zfar="80"/>
  </visual>

  <worldbody>
    <light name="top_light" pos="0 -3 6" dir="0 1 -1" diffuse="0.8 0.8 0.8" castshadow="true"/>

    <geom name="lower_floor" type="plane" pos="0 0 -0.95" size="30 30 0.1" material="lower_floor_mat"/>
    <geom name="floor" type="hfield" pos="0 0 -0.6" hfield="terrain" material="path_mat" rgba="1 1 1 1"/>

    <!-- Mountain skyline: boxes rotated 45deg about Y, half-buried, so only the
         diamond's top half pokes up as a triangular peak. -->
    <geom name="mtn1" type="box" pos="-8 11 -0.035" euler="0 45 0" size="1.6 2.0 1.6" rgba="0.30 0.34 0.44 1" contype="0" conaffinity="0"/>
    <geom name="mtn2" type="box" pos="-4 13 -0.035" euler="0 45 0" size="2.2 2.0 2.2" rgba="0.44 0.50 0.60 1" contype="0" conaffinity="0"/>
    <geom name="mtn3" type="box" pos="0 12 -0.035" euler="0 45 0" size="1.9 2.0 1.9" rgba="0.36 0.40 0.50 1" contype="0" conaffinity="0"/>
    <geom name="mtn4" type="box" pos="4.5 13.5 -0.035" euler="0 45 0" size="2.4 2.0 2.4" rgba="0.47 0.53 0.63 1" contype="0" conaffinity="0"/>
    <geom name="mtn5" type="box" pos="8 11 -0.035" euler="0 45 0" size="1.7 2.0 1.7" rgba="0.32 0.36 0.46 1" contype="0" conaffinity="0"/>
    <geom name="sun" type="sphere" pos="-9 15 7" size="0.7" rgba="0.98 0.86 0.4 1" contype="0" conaffinity="0"/>

    <body name="cart" pos="0 0 0.13">
      <!-- slider_x/slider_y let the cart counteract tilt in either horizontal plane. -->
      <joint name="slider_x" type="slide" axis="1 0 0" limited="true" range="-2.4 2.4"/>
      <joint name="slider_y" type="slide" axis="0 1 0" limited="true" range="-1.2 1.2"/>
      <camera name="world" pos="1.6 -1.3 1.1" xyaxes="0.63 0.78 0 -0.34 0.27 0.90"/>

      <geom name="cart_body" type="box" size="0.24 0.12 0.07" rgba="0.10 0.33 0.75 1" mass="1.0"/>
      <geom name="cart_top" type="box" pos="0 0 0.08" size="0.14 0.09 0.025" rgba="0.08 0.22 0.55 1" mass="0.05"/>
      <geom name="left_wheel" type="sphere" pos="-0.15 -0.13 -0.06" size="0.035" rgba="0.05 0.05 0.05 1" mass="0.02"/>
      <geom name="right_wheel" type="sphere" pos="0.15 -0.13 -0.06" size="0.035" rgba="0.05 0.05 0.05 1" mass="0.02"/>

      <body name="pole" pos="0 0 0.13">
        <!-- hinge_x tips the pole along x (caught by slider_x); hinge_y tips it
             along y (caught by slider_y). -->
        <joint name="hinge_x" type="hinge" axis="0 1 0" limited="false"/>
        <joint name="hinge_y" type="hinge" axis="1 0 0" limited="false"/>
        <!-- Egocentric feed: offset off the pole's own central axis so the shaft
             is visible rather than viewed end-on, and pitched toward the horizon
             (~20deg below) rather than straight down, so rotation (tilt) isn't
             swamped by translation (cart-correction) parallax from close-up ground. -->
        <camera name="pole" pos="0 -0.25 1.0" xyaxes="-1 0 0 0 -0.342 0.9397" fovy="90"/>

        <geom name="pole_bar" type="box" pos="0 0 0.42" size="0.025 0.025 0.42" rgba="0.95 0.48 0.10 1" mass="0.1"/>
        <geom name="pole_tip" type="box" pos="0 0 0.86" size="0.06 0.025 0.025" rgba="0.95 0.48 0.10 1" mass="0.01"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- gear=5: high enough to correct meaningfully, low enough not to snap the
         pole past its termination angle in one step. Tune here to experiment. -->
    <motor name="slide_motor_x" joint="slider_x" gear="5" ctrllimited="true" ctrlrange="-3 3"/>
    <motor name="slide_motor_y" joint="slider_y" gear="5" ctrllimited="true" ctrlrange="-3 3"/>
  </actuator>
</mujoco>
